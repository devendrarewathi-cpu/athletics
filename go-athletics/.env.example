# Verified social profile URLs (must start with https://). Leave empty to hide
# social icons; the "Join us on social media" banner then offers email updates.
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# Public site URL, used for absolute Open Graph image links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
